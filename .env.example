# Copy to `.env` (next to docker-compose.yml) before `docker compose up` - or let
# `./setup.sh` write .env for you (random secrets, sensible answers).
# Never commit the real .env.

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_A_REAL_RANDOM_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
POSTGRES_PASSWORD=123

# production refuses placeholder secrets; development only warns.
ENVIRONMENT=production
# true = create the demo event on an empty database (handy for a dry run).
SEED_DEMO=false
# Port on this computer (default 8000, plain HTTP, this machine only).
# ROUND2_PORT=8000

# How phones reach the game over HTTPS - pick ONE:
#   lan    = laptop on the same Wi-Fi as the phones: self-signed certificate on
#            port 8443 (phones accept a warning once). Needs LAN_IP.
#   public = a server on the internet with a domain name: Caddy fetches a real
#            certificate on ports 80/443 (no warning). Needs SITE_DOMAIN.
COMPOSE_PROFILES=lan
# lan: this computer's Wi-Fi address, so the certificate names the address phones
# open. Find it with `ipconfig`.
LAN_IP=
# ROUND2_HTTPS_PORT=8443
# public: the domain whose DNS A record points at this server (no https://).
SITE_DOMAIN=
