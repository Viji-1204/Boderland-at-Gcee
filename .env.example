# Copy to `.env` (next to docker-compose.yml) before `docker compose up`.
# Never commit the real .env.

# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_A_REAL_RANDOM_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
POSTGRES_PASSWORD=123

# production refuses placeholder secrets; development only warns.
ENVIRONMENT=production
# true = create the demo event on an empty database (handy for a dry run).
SEED_DEMO=false
# Port on this computer (default 8000). Change it if something else uses 8000.
# ROUND2_PORT=8000
