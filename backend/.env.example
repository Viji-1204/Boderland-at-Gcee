# Optional: copy to backend/.env for local runs. Every line is optional;
# the defaults below are what you get without the file.

# ENVIRONMENT=development
# DATABASE_URL=sqlite:///C:/path/to/backend/data/round2.db   (default: backend/data/round2.db)
# DATABASE_URL=postgresql+psycopg2://round2:round2@localhost:5432/round2
# JWT_SECRET=change-me
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=admin123
# SEED_DEMO=true            # demo event on an empty database (unset: development only)
# AUTO_MIGRATE=true         # apply Alembic migrations at startup
# CORS_ORIGINS=*
